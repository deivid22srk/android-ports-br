<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ports" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/oled_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/ports_accent</item>
    </style>

    <style name="Theme.Ports.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/oled_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Ports</item>
    </style>
</resources>
